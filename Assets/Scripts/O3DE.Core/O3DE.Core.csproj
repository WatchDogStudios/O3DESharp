<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!--
      MSBuild only recognises Debug + Release by default. O3DE's CMake build
      uses Debug + Profile + Release, and CMake's include_external_msproject
      writes a "Profile|AnyCPU" entry into the engine solution for this csproj.
      Without an explicit Configurations list MSBuild rejects the solution
      with: "The solution file specifies a project configuration ... that does
      not exist for that project". Declaring Profile here lets the slnx
      reference it cleanly.
    -->
    <Configurations>Debug;Profile;Release</Configurations>
    <Platforms>AnyCPU</Platforms>

    <!-- Assembly Information -->
    <AssemblyName>O3DE.Core</AssemblyName>
    <RootNamespace>O3DE</RootNamespace>
    <Version>1.3.0</Version>
    <Authors>WD Studios Corp.</Authors>
    <Company>WD Studios Corp.</Company>
    <Product>O3DE C# Scripting API</Product>
    <Description>Core C# API for O3DE scripting via Coral .NET Host</Description>
    <Copyright>Copyright (c) Contributors to the Open 3D Engine Project</Copyright>

    <!-- Output Configuration -->
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Build Configuration -->
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Optimization. Profile is a Release-shaped build that keeps debug
         symbols so profilers can resolve stacks. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <Optimize Condition="'$(Configuration)' == 'Profile'">true</Optimize>
    <Optimize Condition="'$(Configuration)' == 'Debug'">false</Optimize>
  </PropertyGroup>

  <!--
    M3 build-mode split. Coral (CoreCLR hosting, hot-reload, reflection) and
    NativeAOT (static, no JIT, no hostfxr) are mutually exclusive PER BUILD
    ARTIFACT - a NativeAOT image has nothing for nethost -> hostfxr to attach
    to. They are two artifacts from one codebase, never a runtime switch.

    This is a property rather than a fourth Configuration because the engine
    slnx, CMake's include_external_msproject and the Configurations list above
    are all wired for Debug/Profile/Release, and host mode is orthogonal to
    optimisation level anyway (a Release Coral build and a Release NativeAOT
    build are both wanted).

    Default is Coral: everything that exists today keeps building exactly as
    it did. Only the M4 publish passes -p:O3DESharpHostMode=NativeAot.
  -->
  <PropertyGroup>
    <O3DESharpHostMode Condition="'$(O3DESharpHostMode)' == ''">Coral</O3DESharpHostMode>

    <!--
      O3DE.Core is the ONE assembly that carries the ManagedExports thunks.
      ManagedExports is a single well-known type; if every consumer assembly
      emitted its own copy the name would resolve ambiguously as soon as two
      of them were referenced together.
    -->
    <O3DESharpEmitHostExports>true</O3DESharpEmitHostExports>
  </PropertyGroup>

  <PropertyGroup Condition="'$(O3DESharpHostMode)' == 'NativeAot'">
    <DefineConstants>$(DefineConstants);O3DE_HOST_NATIVEAOT</DefineConstants>

    <!--
      IsAotCompatible turns on the trim, AOT and single-file analyzers. An
      IL2xxx/IL3xxx warning in a NativeAOT build is a runtime failure waiting
      to happen - reflection over a type the compiler removed, or serialization
      that needs codegen the image does not have - so they are errors here,
      not warnings that accumulate unnoticed.

      Scoped to this mode only. The editor build is behaviour-preserving in M3
      and must not gain new failure modes; HotReloadManager.cs is compiled in
      Coral mode and would legitimately warn there.

      Note this does NOT enable trimming of the CoreCLR artifacts - nothing in
      this repo sets PublishTrimmed. NativeAOT necessarily eliminates dead code
      as part of compiling, which is a property of the toolchain rather than an
      opt-in here.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2072;IL2075;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(O3DESharpHostMode)' != 'NativeAot'">
    <DefineConstants>$(DefineConstants);O3DE_HOST_CORAL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEBUG;TRACE;O3DE_DEBUG</DefineConstants>
    <!--
      vsdbg / Rider / VS managed attach against an embedded CoreCLR
      (Coral delegate-host mode) was returning E_INVALIDARG from
      ICorDebug::DebugActiveProcess when this assembly was built with
      DebugType=portable. Forcing DebugType=full for Debug builds plus
      explicitly disabling single-file publish was the missing piece
      that turned attach green across all three IDEs. The non-Debug
      configs keep portable PDBs (set in the main PropertyGroup
      above) because Profile/Release don't need full Windows-format
      symbols and portable is cheaper to ship.
    -->
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <!-- Force assemblies to stay loose on disk for the debugger -->
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Profile'">
    <DefineConstants>$(DefineConstants);TRACE;O3DE_PROFILE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);TRACE;O3DE_RELEASE</DefineConstants>
  </PropertyGroup>

  <!-- Reference to Coral.Managed for interop support -->
  <ItemGroup>
    <Reference Include="Coral.Managed">
      <!-- Use the Coral.Managed.dll from the gem's bin folder -->
      <HintPath>..\..\..\bin\Coral\Coral.Managed.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Roslyn generators read MSBuild properties through AnalyzerConfigOptions,
    but only ones explicitly published as CompilerVisibleProperty. Without
    these two lines HostExportsGenerator sees neither the host mode nor the
    emit flag and silently emits nothing.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="O3DESharpHostMode" />
    <CompilerVisibleProperty Include="O3DESharpEmitHostExports" />
  </ItemGroup>

  <!--
    The reflected script surface, as dumped by the C++ ReflectionDataExporter.
    StaticDispatchGenerator reads it to emit a compile-time (bus, event) table
    so the shipping build can validate a dispatch without managed reflection.

    Overridable so tests can point at a fixture. Absent is a normal state on a
    fresh clone - the generator emits an empty table and the build succeeds.
  -->
  <PropertyGroup>
    <O3DESharpReflectionData Condition="'$(O3DESharpReflectionData)' == ''">$(MSBuildThisFileDirectory)..\..\..\reflection_data.json</O3DESharpReflectionData>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(O3DESharpReflectionData)')">
    <AdditionalFiles Include="$(O3DESharpReflectionData)" O3DESharpKind="ReflectionData" />
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="O3DESharpKind" />
  </ItemGroup>

  <!--
    Phase 18-E: O3DESharp source generators. The reference is marked
    OutputItemType=Analyzer so MSBuild loads the assembly as a Roslyn
    component rather than a regular reference. ReferenceOutputAssembly=
    false means O3DE.Core.dll doesn't ship the analyzer assembly inside
    itself (it's a build-time-only dependency).

    The generator processes [EBus] / [EBusHandler] attributes on user
    classes that derive from ScriptComponent and emits the
    ConnectTo<BusName> / DisconnectFrom<BusName> / dispatch-shim
    methods. End result: a user class with `[EBus("TickBus")]` gets
    a `ConnectToTickBus()` method generated at compile time, without
    the user writing any of the Connect/Disconnect/dispatch glue.
  -->
  <ItemGroup>
    <!--
      GlobalPropertiesToRemove: ReferenceOutputAssembly="false" only stops
      the analyzer's output from being linked into O3DE.Core - it does NOT
      stop MSBuild's ProjectReference protocol from flowing this project's
      own global properties (Configuration/RuntimeIdentifier/PublishAot/...)
      down into the referenced project's restore+build. Since the analyzer
      is netstandard2.0, letting PublishAot/RuntimeIdentifier leak in makes
      restore fail with NETSDK1207 ("AOT compilation is not supported for
      the target framework") the moment O3DE.Core itself is published AOT.
      The analyzer doesn't need any of these to build.
    -->
    <ProjectReference Include="..\..\..\Code\Tools\SourceGenerators\O3DESharp.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RuntimeIdentifier;PublishAot;SelfContained;PublishReadyToRun;PublishSingleFile;PublishTrimmed" />
  </ItemGroup>

  <!--
    Note: .NET SDK projects automatically include all *.cs files in the project directory.
    Do NOT add explicit <Compile Include="..." /> items - this causes NETSDK1022 duplicate errors.
  -->

  <!--
    NativeAOT's own SDK (Microsoft.DotNet.ILCompiler's Microsoft.NETCore.Native.Publish.targets,
    target CopyNativeBinary) copies the shared library and its debug symbols into $(PublishDir)
    AfterTargets="Publish", but never the Windows import library ($(TargetName).lib) or its
    companion .exp, even though ILCompiler always produces both alongside the .dll for
    NativeLib=Shared - they are left behind in the native intermediate output directory. Mirror
    that same AfterTargets="Publish" shape here so a NativeAOT publish output directory is
    actually complete: a native consumer statically linking against the exported symbols needs
    the .lib, and o3desharp_nativeaot_publish.cmake (Task 17) deploys this directory verbatim.
  -->
  <Target Name="O3DESharpCopyNativeImportLib" AfterTargets="Publish"
          Condition="'$(NativeLib)' == 'Shared' And '$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <_O3DESharpNativeImportLibFiles Include="$(NativeOutputPath)$(TargetName).lib;$(NativeOutputPath)$(TargetName).exp"
                                       Condition="Exists('$(NativeOutputPath)$(TargetName).lib')" />
    </ItemGroup>
    <Copy SourceFiles="@(_O3DESharpNativeImportLibFiles)" DestinationFolder="$(PublishDir)"
          Condition="'@(_O3DESharpNativeImportLibFiles)' != ''" />
  </Target>

</Project>
