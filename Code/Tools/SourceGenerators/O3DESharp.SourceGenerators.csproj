<Project Sdk="Microsoft.NET.Sdk">

  <!--
    O3DESharp source generators (Phase 18-E).

    Roslyn source generators run during compilation and emit additional
    C# source files that the compiler includes alongside the user's own
    code. We use this to process [EBus] / [EBusHandler] attributes on
    user classes and emit:
      - ConnectTo<BusName>(...)
      - DisconnectFrom<BusName>(...)
      - A private dispatch shim that unmarshals JSON args from the C++
        side into typed parameters before invoking the user's method.

    Roslyn requires source generator packages target netstandard2.0
    (the analyzer host's compiler embeds this exact framework version).
    The IsRoslynComponent / EnforceExtendedAnalyzerRules / DevelopmentDependency
    properties below are the standard Roslyn-analyzer packaging metadata.
  -->

  <PropertyGroup>
    <!--
      Restore inherits PublishAot/RuntimeIdentifier from whichever project is
      being NativeAOT-published (O3DE.Core.csproj's M4 publish path): MSBuild's
      restore-graph walk (NuGet.targets' _GenerateRestoreProjectPathWalk)
      propagates the command line's global properties to EVERY project reached
      via ProjectReference, including this Analyzer-only one
      (ReferenceOutputAssembly=false does not exempt it - that only stops the
      output assembly from being linked, not the restore walk). Left alone,
      Microsoft.NET.Publish.targets infers _RequiresILLinkPack=true purely from
      the inherited PublishAot=true, which makes ProcessFrameworkReferences run
      here too and fail restore with NETSDK1207 ("AOT compilation is not
      supported for the target framework") - this project targets
      netstandard2.0 because Roslyn analyzers require it, and is never itself
      AOT-published. Pinning this false (a plain, non-global property) is not
      overridden by the SDK's own conditional default further down: that
      default lives inside a target guarded by Condition="'$(_RequiresILLinkPack)'
      == ''", evaluated at build time, and _RequiresILLinkPack itself is never
      a global property (unlike PublishAot, which arrives as a genuinely
      global property and would beat any project-level override of the same
      name - setting PublishAot=false here would NOT have worked).

      Safe only while this project stays netstandard2.0 - the SDK's
      analyzer-inference rules that would otherwise need _RequiresILLinkPack
      are all gated on TargetFrameworkIdentifier == .NETCoreApp. If this
      project is ever retargeted to a .NETCoreApp TFM with IsAotCompatible /
      IsTrimmable set, this pin would silently suppress the ILLink pack with
      no diagnostic - revisit then.
    -->
    <_RequiresILLinkPack>false</_RequiresILLinkPack>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>O3DESharp.SourceGenerators</RootNamespace>
    <AssemblyName>O3DESharp.SourceGenerators</AssemblyName>

    <!-- Roslyn analyzer packaging metadata -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <!--
    Debug-mode build settings tuned for analyzer attach. Source
    generators run inside the C# compiler process during build, so
    "attach to compiler" is the way to step into them - DebugType=full
    lets that work reliably.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.CodeAnalysis.CSharp 4.4 covers C# 11 + .NET 8 + Roslyn
      source generators incremental API. Pinning a stable version so a
      compiler/SDK update doesn't break the generator's source-emit
      shape under us.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.4.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />

    <!--
      StaticDispatchGenerator reads reflection_data.json. GeneratePathProperty +
      the analyzer packaging below is the standard way to make a dependency
      available INSIDE the compiler process - a plain PackageReference would be
      resolved for the consumer, not for the analyzer host.
    -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    Analyzer release tracking (RS2008, enforced by EnforceExtendedAnalyzerRules
    above). DynamicDispatchAnalyzer is the first plain DiagnosticAnalyzer in
    this project - the existing generators don't carry SupportedDiagnostics,
    so this pair of files wasn't needed until now.
  -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
